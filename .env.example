# --- Base de datos -----------------------------------------------------------
# Desarrollo local: SQLite (cero dependencias).
WMS_DB_URL=sqlite:///./data/wms.db
# Despliegue con Docker: PostgreSQL
# WMS_DB_URL=postgresql+psycopg://wms:wms@localhost:5433/wms

# --- LLM ---------------------------------------------------------------------
# rule-based = baseline determinista offline (sin costo ni API key).
# openai | anthropic | ollama
WMS_LLM_PROVIDER=rule-based
# WMS_LLM_MODEL=gpt-4o-mini
WMS_LLM_TEMPERATURE=0
WMS_LLM_MAX_TOKENS=900

# --- Embeddings --------------------------------------------------------------
# hashing = offline y determinista (ideal para CI). openai | ollama
WMS_EMBEDDING_PROVIDER=hashing
# WMS_EMBEDDING_MODEL=text-embedding-3-small

# --- Guardrails SQL ----------------------------------------------------------
WMS_SQL_ROW_LIMIT=200
WMS_SQL_TIMEOUT_S=3

# --- RAG ---------------------------------------------------------------------
WMS_RAG_TOP_K=4
WMS_KB_DIR=./kb

# --- Observabilidad ----------------------------------------------------------
WMS_TELEMETRY=1

# --- Credenciales (solo si usas proveedores reales) --------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://localhost:11434
